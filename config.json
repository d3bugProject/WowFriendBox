{
  "hotkeys": {
    "toggle_broadcast": "ScrollLock",
    "toggle_mouse_broadcast": "Pause",
    "reapply_layout": "Home",
    "slot_keys": [
      "F1",
      "F2",
      "F3",
      "F4",
      "F5"
    ]
  },
  "broadcast": {
    "enabled_by_default": false,
    "whitelist": [
      "1",
      "2",
      "3",
      "4",
      "5",
      "6",
      "7",
      "8",
      "9",
      "0",
      "-",
      "=",
      "NumPad0",
      "NumPad1",
      "NumPad2",
      "NumPad3",
      "NumPad4",
      "NumPad5",
      "NumPad6",
      "NumPad7",
      "NumPad8",
      "NumPad9"
    ],
    "blacklist": [
      "Return",
      "Space",
      "Tab",
      "Escape",
      "W",
      "A",
      "S",
      "D",
      "Z",
      "Q"
    ],
    "input_delay_ms": 0
  },
  "layout": {
    "screen_resolution": [
      2560,
      1080
    ],
    "center_window_size": [
      1500,
      843
    ],
    "remove_borders": true,
    "prevent_background_focus": true
  }
}
